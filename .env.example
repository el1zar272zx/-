# Токен клієнтського бота (від @BotFather)
CLIENT_BOT_TOKEN=
# Токен адмін-бота — другий бот, створюється окремо в @BotFather
ADMIN_BOT_TOKEN=
# Ваш Telegram ID (число). Якщо не знаєте — запустіть бота, напишіть адмін-боту: він покаже ID
SUPERADMIN_TELEGRAM_ID=

DATABASE_URL=sqlite+aiosqlite:///./salon.db
TIMEZONE=Europe/Kyiv

# Необовʼязково
# REVIEW_DELAY_MINUTES=120     # через скільки хв після візиту просити відгук
# MORNING_DIGEST_HOUR=8        # година ранкової сводки для адмінів
# BACKUP_HOUR=3                # година щоденного бекапу (надсилається власнику)
# LOYALTY_EVERY=5              # кожен N-й візит клієнта...
# LOYALTY_DISCOUNT_PERCENT=0   # ...зі знижкою P% (0 = вимкнено, лише лічильник візитів)
# SLOT_STEP_MINUTES=30
# MAX_DAYS_AHEAD=30
# MIN_LEAD_MINUTES=60
# NOTIFY_HOURS_BEFORE_1=24
# NOTIFY_HOURS_BEFORE_MID=12
# NOTIFY_HOURS_BEFORE_2=2
# ADMIN_NOTIFY_MINUTES_BEFORE=60
# SINGLE_SPECIALIST=true
# DB_ECHO=false

# --- Нове ---
# BUFFER_MINUTES=10            пауза між сеансами
# LOYALTY_EVERY=5              кожен 5-й візит зі знижкою
# LOYALTY_DISCOUNT_PERCENT=10  розмір знижки, % (0 = вимкнути)
# MIN_CHANGE_HOURS=3           за скільки годин ще можна перенести запис
# REENGAGE_DAYS=30             нагадати клієнтам, яких не було стільки днів
# SALON_ADDRESS=вул. Прикладна, 1, Жовті Води
# SALON_PHONE=+380...
# SALON_MAP_URL=https://maps.app.goo.gl/...
# SALON_LAT=48.34
# SALON_LON=33.50
# BACKUP_EXTRA_DIR=C:\Users\elikp\Google Drive\salon_backup   папка, що синхронізується з хмарою
